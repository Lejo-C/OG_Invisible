{
  "manifest_version": 3,
  "name": "Stimulation Governor",
  "version": "0.1.0",
  "description": "Chrome extension to govern stimulation levels on YouTube.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Stimulation Governor"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
